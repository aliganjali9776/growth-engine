# Production configuration. Supply values in your hosting secret manager.
# Never commit secrets or prefix them with NEXT_PUBLIC_.
APP_MODE=saas
PERSISTENCE_MODE=database
DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Canonical application origin, no trailing slash; auth and invitation base URL.
BETTER_AUTH_URL=https://app.example.com
# Generate at least 32 random characters; keep stable across restarts.
BETTER_AUTH_SECRET=
AGENT_MODEL_PROVIDER=openai
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna. Requires model access in your OpenAI project.
OPENAI_MODEL=gpt-6-luna
INVITATION_TTL_DAYS=7
SAAS_DEV_DATABASE=false
SAAS_DEV_API_ENABLED=false
AGENT_ALLOW_MOCK_DEMO=false
# Optional platform operators, separate from organization roles. Empty denies all.
# Create and secure the intended account BEFORE adding its email here.
PLATFORM_ADMIN_EMAILS=
